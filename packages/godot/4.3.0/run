#!/usr/bin/env bash

# Headless GDScript runner. Main file must extend SceneTree (or MainLoop)
# and call quit() when finished, e.g.:
#   extends SceneTree
#   func _init():
#       print("OK")
#       quit()
#
# Filter the common missing-libfontconfig warning on minimal API images.
ERR=$(mktemp)
godot --headless --no-header --script "$@" 2>"$ERR"
STATUS=$?
grep -vF 'libfontconfig.so' "$ERR" >&2 || true
rm -f "$ERR"
exit $STATUS
